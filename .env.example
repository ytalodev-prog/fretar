# Copie para .env, preencha os segredos e nunca envie o arquivo ao repositorio.
PORT=3000

# Neon PostgreSQL para deploy na Vercel. Deixe vazio para usar o JSON local.
DATABASE_URL=

# Conta unica do recebedor (Portaria)
PORTARIA_LOGIN=Portaria
PORTARIA_PASSWORD=

# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# O Compose define production automaticamente. Para npm start local, use development.
NODE_ENV=development

# Volume persistente: em Docker Compose fica em /app/data.
DATA_DIR=data
